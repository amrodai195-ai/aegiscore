NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MySQL (Aiven free tier)
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

# Long random secret (32+ bytes recommended)
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret

# GitHub OAuth App
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_SCOPES=read:user user:email repo

# Supabase Storage (Free plan: storage is used for source artifacts)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=aegiscore

# AI — no fake fallback is used when this is missing.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
